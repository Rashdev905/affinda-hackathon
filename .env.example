# The backend reads environment variables from the shell. No .env loader is required.
# Optional absolute SQLite location (default: backend/data/pulse.db)
# PULSE_DB_PATH=C:/path/to/pulse.db
# PULSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Vite proxy target, if the local backend uses a different port:
# PULSE_API_TARGET=http://127.0.0.1:8000

